# Public-safe placeholders only. Never commit a populated .env file.

# --- Core ---
TALLY_CRDB_DSN=REPLACE_WITH_SECRET_DSN
TALLY_TENANT_ID=REPLACE_WITH_SERVER_SIDE_SYNTHETIC_TENANT_UUID
AWS_PROFILE=REPLACE_WITH_SCOPED_DEPLOYER_PROFILE
AWS_REGION=us-east-1

# --- Judge authentication (Amazon Cognito) ---
# Cognito is enforced only when TALLY_JUDGE_AUTH_ENABLED=true AND both ids are
# present. Left false, the app falls back to a static bearer token so local runs
# and the test suite work without AWS.
TALLY_JUDGE_AUTH_ENABLED=false
TALLY_COGNITO_USER_POOL_ID=REPLACE_WITH_COGNITO_USER_POOL_ID
TALLY_COGNITO_CLIENT_ID=REPLACE_WITH_COGNITO_APP_CLIENT_ID

# --- Intake: versioned S3 retention + durable workers ---
TALLY_INTAKE_BUCKET=REPLACE_WITH_PRIVATE_VERSIONED_SYNTHETIC_BUCKET
TALLY_INTAKE_KEY_PREFIX=REPLACE_WITH_KEY_PREFIX
TALLY_INTAKE_DEMO_ENABLED=true
TALLY_INTAKE_WORKER_ENABLED=true

# --- CockroachDB Managed MCP (reconstruction read path) ---
TALLY_MCP_CLUSTER_ID=REPLACE_WITH_SERVER_SIDE_CLUSTER_ID
TALLY_MCP_DATABASE=REPLACE_WITH_SYNTHETIC_DATABASE_NAME
# Preferred credential is a non-expiring service-account API key held in SSM.
# The OAuth bundle below and its rotation lease are the fallback path.
TALLY_OAUTH_TOKEN_PARAMETER=REPLACE_WITH_SSM_OAUTH_BUNDLE_PARAMETER
TALLY_OAUTH_REFRESH_LEASE_TABLE=REPLACE_WITH_OAUTH_LEASE_TABLE

# --- Static assets (the built SPA, served same-origin) ---
TALLY_STATIC_DIR=/app/ui

# --- Superseded public-replay demo: disabled. The judge path is the
# --- authenticated workbench above.
TALLY_PUBLIC_DEMO_ENABLED=false
